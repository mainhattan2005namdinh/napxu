# Mẫu cấu hình — copy thành file .env rồi điền giá trị thật.
# File .env chứa bí mật, đã được .gitignore chặn, KHÔNG commit / gửi cho ai.

# API token tạo ở https://user.tikhub.io (mục API Token)
TIKHUB_API_KEY=

# Cổng chạy web (mặc định 3000)
PORT=3000

# Nhớ kết quả tra cứu bao nhiêu phút (đỡ tốn credit khi khách đăng nhập lại)
CACHE_TTL_MINUTES=30

# Mỗi IP được tra tối đa bao nhiêu lần/phút (chống spam đốt credit)
LOOKUPS_PER_IP_PER_MINUTE=5

# Trần số lần gọi TikHub mỗi ngày (bảo vệ số dư). $0.05 free ≈ 50 lượt
DAILY_TIKHUB_LIMIT=200

# Đặt 1 khi chạy sau proxy (Render, Railway, Nginx, Cloudflare) để lấy đúng IP khách
TRUST_PROXY=0
